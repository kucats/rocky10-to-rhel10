#!/bin/sh
# ssh-legacy / scp-legacy: reach an old SSH server (ssh-rsa host keys,
# SHA-1 key exchange) from RHEL 10 without weakening the system crypto policy.
#
# The DEFAULT policy makes OpenSSL reject SHA-1 signatures, so +ssh-rsa alone
# is not enough. This wrapper allows SHA-1 signatures for this one process
# only, through a private OPENSSL_CONF, and enables the legacy algorithms on
# the command line. Install as ~/bin/ssh-legacy and symlink scp-legacy to it.
#
# Usage: ssh-legacy [ssh options] host [command]
#        scp-legacy [scp options] src dst
set -eu
cnf=${SSH_LEGACY_OPENSSL_CONF:-$HOME/.ssh/legacy/openssl-sha1.cnf}
if [ ! -f "$cnf" ]; then
  mkdir -p "$(dirname "$cnf")"
  umask 077
  cat > "$cnf" <<'EOF'
# Per-process OpenSSL config for ssh-legacy: the system config plus SHA-1
# signatures allowed. Only processes started with OPENSSL_CONF=<this> use it.
.include /etc/pki/tls/openssl.cnf
[openssl_init]
alg_section = evp_properties
[evp_properties]
rh-allow-sha1-signatures = yes
EOF
fi
export OPENSSL_CONF="$cnf"
opts="-o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1"
case $(basename "$0") in
  scp-legacy) prog=scp ;;
  *) prog=ssh ;;
esac
# shellcheck disable=SC2086
exec "$prog" $opts "$@"
