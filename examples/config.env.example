# r2r configuration. Copy to config.env (gitignored) and edit.
# Relative paths are relative to this file's directory.
# All addresses below are documentation placeholders (RFC 5737 / RFC 3849).

# ---- libraries ----
SOURCE_OS=rocky10            # lib/os/rocky10.sh   (running system)
TARGET_OS=rhel10             # lib/os/rhel10.sh    (image to write)
PROVIDER=sakura-vps          # lib/provider/<name>.sh (sakura-vps | generic)

# ---- image ----
QCOW2=./images/rhel-10.x-x86_64-kvm.qcow2   # from the Red Hat customer portal
WORKDIR=./work                               # outputs (raw, zst, manifest, seed)
IMAGE_NAME=rhel10-target                     # output basename
ZSTD_LEVEL=12
# Linux helper used when this machine is not Linux+root (docker or podman).
#HELPER_IMAGE=quay.io/fedora/fedora:42
#CONTAINER_CMD=docker

# ---- identity ----
HOSTNAME_FQDN=host.example.com
#INSTANCE_ID=r2r-host-1      # default: derived from hostname and time

# ---- network (provider sets defaults for NET_MODE / NIC_NAME) ----
#NET_MODE=static             # static | dhcp
#NIC_NAME=ens3
NIC_MAC=52:54:00:12:34:56    # the VPS NIC's real MAC (panel or `ip -br link`)
IPV4_ADDR=192.0.2.10/24      # static only
IPV4_GW=192.0.2.1            # static only
DNS_SERVERS="192.0.2.53 198.51.100.53"
#IPV6_ADDR=2001:db8:10::10/64  # optional static IPv6
#IPV6_GW=fe80::1

# ---- users (public keys only; one key per line in the files) ----
ADMIN_USER=admin             # interactive admin, in wheel, sudo needs a password
ADMIN_UID=1000
ADMIN_GROUPS=wheel
ADMIN_KEYS_FILE=./keys/admin.pub
# Optional SHA-512 crypt hash (e.g. from `openssl passwd -6`), so the admin
# can use sudo. Leave empty to lock the password and set it after first login.
# Put the hash in SINGLE quotes: it contains '$', which the shell would expand.
ADMIN_HASHED_PASSWD=
AUTOMATION_USER=automation   # optional; the only user with NOPASSWD sudo
AUTOMATION_UID=1001
AUTOMATION_GROUPS=
AUTOMATION_KEYS_FILE=./keys/automation.pub

# Optional: keep the server's SSH host identity. A directory holding
# ssh_host_{rsa,ecdsa,ed25519}_key and .pub copied (securely) from the old
# system. The image then contains private keys: treat it as a secret.
#HOSTKEY_DIR=./hostkeys

# ---- local qemu test ----
TEST_SSH_USER=admin
TEST_SSH_KEY=~/.ssh/id_ed25519   # private key matching an authorized key
TEST_DISK_SIZE=50G               # overlay size, exercises growpart
TEST_SSH_PORT=2222
TEST_TIMEOUT=900                 # seconds (TCG emulation is slow)

# ---- target (staging) ----
TARGET_SSH=admin@192.0.2.10      # the running Rocky 10 VPS
#TARGET_SSH_OPTS="-i ~/.ssh/id_ed25519"
TARGET_SUDO=sudo                 # empty if TARGET_SSH logs in as root
#TARGET_DISK=/dev/vda
STAGE_DIR=/var/tmp/r2r
#FILLER_GB=12                    # default: max(12, raw GiB + 2)
